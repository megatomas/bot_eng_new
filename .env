# ============================================================
# English Learning Telegram Bot - Configuration
# ============================================================

# Bot Token (обязательно)
# Получить: @BotFather в Telegram → /newbot
BOT_TOKEN=your_telegram_bot_token_here

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/english_bot

# ============================================================
# AI - БЕСПЛАТНЫЕ провайдеры
# ============================================================
# Groq (РЕКОМЕНДУЕТСЯ): https://console.groq.com/
# - Llama 3.3 70B (качество GPT-4)
# - 30 запросов/мин, 14400/день
# - Полностью бесплатный
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (альтернатива): https://aistudio.google.com/apikey
# - 15 запросов/мин, 1M токенов/день
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (платный, если нужен)
# OPENAI_API_KEY=sk-your_openai_key_here

# ============================================================
# Speech - БЕСПЛАТНЫЕ провайдеры
# ============================================================
# TTS (озвучка текста):
# - edge: Microsoft Edge (ЛУЧШИЙ, бесплатный, без API ключа)
# - gtts: Google TTS (простой, роботизированный)
TTS_PROVIDER=edge
TTS_VOICE=en-US-JennyNeural

# STT (распознавание речи):
# - whisper: OpenAI Whisper (ЛУЧШИЙ, локальный, бесплатный)
# - vosk: лёгкий офлайн (менее точный)
STT_PROVIDER=whisper
WHISPER_MODEL=base  # tiny, base, small, medium, large

# ============================================================
# App Settings
# ============================================================
DEBUG=false
LOG_LEVEL=INFO
