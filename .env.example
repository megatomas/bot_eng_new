# Bot
BOT_TOKEN=your_telegram_bot_token_here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/english_bot

# AI (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Speech (optional)
TTS_PROVIDER=google  # google, openai, elevenlabs
