# Bot
BOT_TOKEN=your_telegram_bot_token_here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/english_bot

# AI — БЕСПЛАТНЫЕ варианты:
# Groq (рекомендуется): https://console.groq.com/ — Llama 3.3, бесплатно
# Gemini: https://aistudio.google.com/apikey — бесплатно
LLM_PROVIDER=groq  # groq, gemini
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Speech — БЕСПЛАТНЫЕ варианты:
# TTS: edge (Microsoft Edge, лучший), gtts (Google, простой)
# STT: whisper (OpenAI, локальный), vosk (лёгкий офлайн)
TTS_PROVIDER=edge  # edge, gtts
STT_PROVIDER=whisper  # whisper, vosk

# App
DEBUG=false
LOG_LEVEL=INFO
